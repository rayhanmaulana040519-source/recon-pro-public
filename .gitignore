# ---------------------------------------------------------------------------
# Never commit secrets or per-run state.
# The active pipeline keeps its config, proxy list, exclusion list, scope list
# and bot state under ~/recon_pro/state, but these patterns also protect a
# checkout that was pointed at the project folder.
# ---------------------------------------------------------------------------
recon_pro.conf
proxies.txt
exclusions.txt
scope.txt
extra_scope.txt
web_token
*.log

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Passive toolkit runtime data (reports, snapshots, alerts).
# Scan output arrives as directories, .jsonl ledgers and .json reports, so the
# patterns cover everything inside these two folders instead of single names.
# The example report and the placeholder stay tracked: ignoring "dir/*" rather
# than "dir/" is what makes that possible, since git cannot re-include a file
# whose parent directory is excluded.
# ---------------------------------------------------------------------------
bugbounty-toolkit/data/history/*
bugbounty-toolkit/data/extra_scope.txt
bugbounty-toolkit/reports/*
!bugbounty-toolkit/data/history/.gitkeep
!bugbounty-toolkit/reports/example-report.md

# ---------------------------------------------------------------------------
# Scan workspaces, in case one is ever created inside the checkout.
# ---------------------------------------------------------------------------
runs/
reports/*/
state/bot/

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store


# Temporary VPS MCP updater runtime state
vps_mcp/.venv/
state/mcp_api_key
state/mcp_url
state/mcp.pid
state/cloudflared.pid
state/mcp.log
state/cloudflared.log
state/mcp.env
state/mcp_hostname
